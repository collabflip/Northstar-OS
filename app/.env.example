# Northstar SellerOS — environment template.
# Every variable the code reads is listed here (verified against api/, src/, db/,
# evals/, scripts/ via `grep -rhoE "process\.env\.[A-Z_]+"`). Copy to .env and fill in.
# "Required" = boot fails without it ONLY when NODE_ENV=production (api/lib/env.ts);
# in development, missing values fall back to empty strings and the mock providers.
# All values below are non-secret placeholders — never commit a real .env.

# ── Auth (Kimi OAuth) ──────────────────────────────────────────
APP_ID=your-app-id                    # OAuth application client ID; also the expected session-JWT clientId. Required in production.
APP_SECRET=change-me-app-secret       # OAuth client secret AND session-JWT signing key (dual use — rotate together). Required in production.
KIMI_AUTH_URL=https://auth.example.com # Kimi OAuth server base URL (authorize, token exchange, JWKS). Required in production.
KIMI_OPEN_URL=https://open.example.com # Kimi Open Platform base URL (profile fetch). Required in production.
OWNER_UNION_ID=                       # Optional. Union ID of the app creator; that user gets the admin role on first login.

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/northstar # MySQL/TiDB connection string (app, db:push, db:seed, live-DB tests). Required in production.

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development                  # Optional. "production" turns missing required vars into boot failures.
PORT=3000                             # Optional. API listen port (default 3000).
DRAINER_INTERVAL_MS=30000             # Optional. Outbox drainer worker cadence in ms (default 30000; 0 disables the interval worker).

# ── Model gateway (live provider; mock is the default) ─────────
MODEL_GATEWAY_BASE_URL=               # Optional. OpenAI-compatible endpoint; unset → deterministic mock provider only.
MODEL_GATEWAY_API_KEY=                # Only with a live provider. Never commit a real key; never place it in model context or logs.
MODEL_GATEWAY_MODEL=kimi-k3           # Optional. Model name recorded to model_calls.modelVersion (default kimi-k3).

# ── Frontend (platform convention — NOT read by the current SPA) ─
# The SPA starts OAuth via the relative path /api/oauth/login (src/pages/Login.tsx),
# so no build-time frontend config is required today; kept for platform convention.
VITE_APP_ID=                          # Not read by the current frontend.
VITE_KIMI_AUTH_URL=                   # Not read by the current frontend.
